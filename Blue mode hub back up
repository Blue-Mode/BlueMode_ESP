local PlayerCountLabel, FriendCountLabel = nil, nil
local function UpdateCounts()
    local total = #Players:GetPlayers()
    local friends = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and LocalPlayer:IsFriendsWith(p.UserId) then friends += 1 end
    end
    if PlayerCountLabel then PlayerCountLabel.Text = "👥 Players: "..total end
    if FriendCountLabel then FriendCountLabel.Text = "🤝 Friends: "..friends end
end

-- ===== SEARCH MATCH =====
local function MatchesSearch(p)
    if SearchText == "" then return true end
    local s = string.lower(SearchText)
    if SearchMode == "USERNAME" then
        return string.find(string.lower(p.Name), s, 1, true)
    else
        return string.find(string.lower(p.DisplayName), s, 1, true)
    end
end

