        Hue = (Hue + Delta * 0.5) % 1
        BlueAnimTime = (BlueAnimTime + Delta * 0.8) % 1
        GreenAnimTime = (GreenAnimTime + Delta * 0.8) % 1
        RedAnimTime = (RedAnimTime + Delta * 0.8) % 1
        PurpleAnimTime = (PurpleAnimTime + Delta * 0.8) % 1

