    if not p then
        for _, lbl in ipairs(InfoLabels) do
            local base = string.split(lbl.Text, ":")[1]
            lbl.Text = base..": —"
        end
        SelectedUsername = ""
        SelectedDisplayName = ""
        LastProfileLink = ""
        SelectedPlayer = nil
        return
    end
    SelectedPlayer = p
    SelectedUsername = p.Name
    SelectedDisplayName = p.DisplayName
    AddToRecent(p)
    LastProfileLink = "https://www.roblox.com/users/" .. p.UserId .. "/profile"
    
