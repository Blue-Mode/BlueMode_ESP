-- ===== SAVE/LOAD ALL SETTINGS =====
local function LoadSettings()
    pcall(function()
        local s = readfile(SETTINGS_KEY)
        if s then
            local data = HttpService:JSONDecode(s)
            if data then
                SearchMode = data.SearchMode or "USERNAME"
                SearchText = data.SearchText or ""
                SavedMenuVisible = data.MenuVisible or false
            end
        end
    end)
end
local function SaveSettings()
    pcall(function()
        writefile(SETTINGS_KEY, HttpService:JSONEncode({
            SearchMode = SearchMode,
            SearchText = SearchText,
            MenuVisible = MenuVisible
        }))
    end)
end

-- ===== SAVE/LOAD RECENT =====
local function LoadRecent()
    RecentPlayers = {}
    pcall(function()
        local s = readfile(RECENT_KEY)
        if s then RecentPlayers = HttpService:JSONDecode(s) or {} end
    end)
end
local function SaveRecent()
    pcall(function() writefile(RECENT_KEY, HttpService:JSONEncode(RecentPlayers)) end)
end
local function AddToRecent(p)
    if not p then return end
    for i = #RecentPlayers, 1, -1 do
        if RecentPlayers[i].userId == p.UserId then table.remove(RecentPlayers, i) end
    end
    table.insert(RecentPlayers, 1, {userId = p.UserId, name = p.Name, displayName = p.DisplayName})
    while #RecentPlayers > MAX_RECENT do table.remove(RecentPlayers) end
    SaveRecent()
end
local function FindLive(saved)
    for _, p in ipairs(Players:GetPlayers()) do
        if p.UserId == saved.userId then return p end
    end
    return nil
end

-- 💀 STOP VIEWING
local function StopViewing()
    getgenv().BlueMode_Active_View_Session = THIS_SESSION + 1000
    ViewTarget = nil
    if ViewConnection then ViewConnection:Disconnect(); ViewConnection = nil end
    
    local function LockCameraToMe()
        Camera.CameraSubject = nil
        Camera.CameraType = Enum.CameraType.Custom
        if LocalPlayer and LocalPlayer.Character then
            local Root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local Hum = LocalPlayer.Character:FindFirstChild("Humanoid")
            if Root then Camera.CFrame = CFrame.new(Root.Position + Vector3.new(0, 6, -22), Root.Position) end
            if Hum then Camera.CameraSubject = Hum end
        end
    end
    for i = 1, 10 do LockCameraToMe(); task.wait(0.03) end
end

-- ✅ START VIEWING
local function StartViewing(p)
    if not p or not p.Character or not p.Character:FindFirstChild("Humanoid") then return end
    StopViewing()
    task.wait(0.08)
    getgenv().BlueMode_Active_View_Session = THIS_SESSION
    ViewTarget = p
    Camera.CameraType = Enum.CameraType.Follow
    ViewConnection = RunService.RenderStepped:Connect(function()
        if getgenv().BlueMode_Active_View_Session ~= THIS_SESSION then
            if ViewConnection then ViewConnection:Disconnect(); ViewConnection = nil end
            return
        end
        if not ViewTarget or not ViewTarget.Character then StopViewing(); return end
        local Hum = ViewTarget.Character:FindFirstChild("Humanoid")
        if Hum then Camera.CameraSubject = Hum end
    end)
end

-- ✅ TP TO PLAYER
local function TeleportToPlayer(p)
    if not p or not p.Character or not LocalPlayer.Character then return false end
    local MyRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local TarRoot = p.Character:FindFirstChild("HumanoidRootPart")
    if not MyRoot or not TarRoot then return false end
    MyRoot.CFrame = CFrame.new(TarRoot.Position + Vector3.new(3, 1.5, 0))
    task.wait(0.1)
    return true
end

