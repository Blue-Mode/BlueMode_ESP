-- ===== REFRESH LISTS =====
local function RefreshServerList()
    if not PlayerListScroller then return end
    for _, c in ipairs(PlayerListScroller:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
    local list = Players:GetPlayers()
    table.sort(list, function(a,b) return string.lower(a.DisplayName..a.Name) < string.lower(b.DisplayName..b.Name) end)
    local y = 0
    for _, p in ipairs(list) do
        if not MatchesSearch(p) then continue end
        local isFriend = p ~= LocalPlayer and LocalPlayer:IsFriendsWith(p.UserId)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -8, 0, 28)
        btn.Position = UDim2.new(0, 4, 0, y)
        btn.BackgroundColor3 = isFriend and Color3.fromRGB(40,100,60) or Color3.fromRGB(40,80,50)
        btn.Text = p.DisplayName .. " @" .. p.Name .. (isFriend and " 🤝" or "")
        btn.TextColor3 = Color3.new(1,1,1)
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 11
        btn.AutoButtonColor = false
        btn.Parent = PlayerListScroller
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
        btn.MouseButton1Click:Connect(function() ShowPlayerInfo(p) end)
        y += 32
    end
    PlayerListScroller.CanvasSize = UDim2.new(0,0,0,y)
    UpdateCounts()
end

local function RefreshRecentList()
    if not RecentScroller then return end
    for _, c in ipairs(RecentScroller:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
    local y = 0
    for _, saved in ipairs(RecentPlayers) do
