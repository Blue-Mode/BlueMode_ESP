	infoLabel.BackgroundColor3 = Color3.fromRGB(25, 35, 55)
	infoLabel.TextColor3 = Color3.fromRGB(150, 200, 255)
	infoLabel.Text = "📍 Click anywhere to teleport"
	infoLabel.Font = Enum.Font.Gotham
	infoLabel.TextSize = 11
	infoLabel.TextWrapped = true
	infoLabel.BorderSizePixel = 0
	infoLabel.Parent = contentWrapper

	local infoCorner = Instance.new("UICorner")
	infoCorner.CornerRadius = UDim.new(0, 10)
	infoCorner.Parent = infoLabel

	local infoStroke = Instance.new("UIStroke")
	infoStroke.Color = Color3.fromRGB(100, 150, 200)
	infoStroke.Thickness = 1
	infoStroke.Parent = infoLabel

	-- Dragging
	local dragging = false
	local dragStart = nil
	local startPos = nil

	local function startDrag()
		dragging = true
		dragStart = UserInputService:GetMouseLocation()
		startPos = main.Position
	end

	local function stopDrag()
		dragging = false
	end

	header.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			startDrag()
		end
	end)

	header.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			stopDrag()
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and dragging then
			local currentMouse = UserInputService:GetMouseLocation()
			local delta = currentMouse - dragStart
			main.Position = startPos + UDim2.new(0, delta.X, 0, delta.Y)
		end
	end)

	-- Toggle button logic
	local function updateToggleButton()
		if config.tpEnabled then
			toggleBtn.BackgroundColor3 = Color3.fromRGB(80, 200, 80)
			toggleBtn.Text = "TURN OFF"
			toggleStroke.Color = Color3.fromRGB(120, 255, 120)
			statusLabel.TextColor3 = Color3.fromRGB(80, 255, 80)
			statusLabel.Text = "Status: ON ✓"
			infoLabel.Text = "🎯 Click anywhere to teleport"
			notify("✅ Teleport ENABLED - Click anywhere to TP", Color3.fromRGB(80, 220, 120))
		else
			toggleBtn.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
			toggleBtn.Text = "TURN ON"
			toggleStroke.Color = Color3.fromRGB(255, 120, 120)
			statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
			statusLabel.Text = "Status: OFF"
			infoLabel.Text = "📍 Click to enable teleport"
			notify("❌ Teleport DISABLED", Color3.fromRGB(255, 150, 100))
		end
	end

	toggleBtn.MouseButton1Click:Connect(function()
		config.tpEnabled = not config.tpEnabled
		updateToggleButton()
	end)

	-- Minimize logic
	minimizeBtn.MouseButton1Click:Connect(function()
		config.guiMinimized = not config.guiMinimized

		if config.guiMinimized then
			minimizeBtn.Text = "+"
			contentWrapper.Visible = false
			local tween = TweenService:Create(main, TweenInfo.new(0.3), {Size = UDim2.new(0, 380, 0, 50)})
			tween:Play()
			notify("📦 GUI Minimized", Color3.fromRGB(255, 180, 0))
		else
			minimizeBtn.Text = "−"
			contentWrapper.Visible = true
			local tween = TweenService:Create(main, TweenInfo.new(0.3), {Size = UDim2.new(0, 380, 0, 200)})
			tween:Play()
			notify("📂 GUI Expanded", Color3.fromRGB(100, 200, 255))
		end
	end)

	-- Delete button logic
	deleteBtn.MouseButton1Click:Connect(function()
		notify("🗑️ Teleport Tool Deleted - Script removed", Color3.fromRGB(255, 100, 100), 2)
		wait(0.5)
		screenGui:Destroy()
		-- Remove click handler
		mouse.Button1Down:Disconnect()
	end)

	return screenGui, main
end

-- Create the GUI
local gui, mainFrame = createMainGui()

-- Mouse click handler for teleportation
local teleportConnection
teleportConnection = mouse.Button1Down:Connect(function()
	if not config.tpEnabled then return end

	local targetPosition = mouse.Hit.Position

	-- Validate position
	if targetPosition == Vector3.new(0, 0, 0) then
		notify("❌ Invalid target location", Color3.fromRGB(255, 100, 100))
		return
	end

	-- Teleport with animation
	animateTeleport(targetPosition)
	notify("✨ Teleported to " .. tostring(targetPosition), Color3.fromRGB(100, 220, 255), 2)
end)

-- Cleanup on player leaving
Players.PlayerRemoving:Connect(function(leftPlayer)
	if leftPlayer == player then
		teleportConnection:Disconnect()
		gui:Destroy()
	end
end)

notify("📍 Teleport Tool Loaded - Click the button to enable teleport", Color3.fromRGB(100, 200, 255), 3)
print("[Teleport Tool] Script loaded successfully")
