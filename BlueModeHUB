 else
  TelekinesisTarget=assemblyRoot
  TelekinesisTargetPosition=assemblyRoot.Position
  if TelekinesisPickButton then TelekinesisPickButton.Text="PICK UP: "..assemblyRoot.Name end
  TelekinesisNotice("Selected '"..assemblyRoot.Name.."'. Tap PICK UP SELECTED BLOCK.")
