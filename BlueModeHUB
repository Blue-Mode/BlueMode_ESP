  if movers then
   for _, mover in ipairs(movers) do
    if typeof(mover) == "Instance" then pcall(function() mover:Destroy() end) end
   end
   -- Restore every part's original collision setting when magnet is stopped.
   local collisionStates = movers.CollisionStates
   if collisionStates then
    for bodyPart, wasCollidable in pairs(collisionStates) do
     if bodyPart and bodyPart.Parent then pcall(function() bodyPart.CanCollide = wasCollidable end) end
    end
   end
   RestoreAssemblyMass(part, movers.PhysicalStates)
  end
 end
