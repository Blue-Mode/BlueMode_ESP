                    h.OutlineTransparency = 0
                end
            end
            -- Remove temporary role/gun highlights outside MM2.
            if not isMM2 then
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("Model") then
                        local h = obj:FindFirstChild(BMH_ROLE_HIGHLIGHT); if h then h:Destroy() end
                    elseif obj:IsA("Tool") then
                        local h = obj:FindFirstChild(BMH_GUN_HIGHLIGHT); if h then h:Destroy() end
