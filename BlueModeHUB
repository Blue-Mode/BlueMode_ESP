-- Listen to Roblox's server-delivered TextChatService stream and individual text channels.
-- Some experiences raise both events for the same message, so briefly deduplicate them.
local RecentServerChatFingerprints={}
local function ProcessServerChatMessage(chatMessage)
 if not chatMessage or type(chatMessage.Text)~="string" or chatMessage.Text=="" then return end
 local userId=chatMessage.TextSource and chatMessage.TextSource.UserId or nil
 local sender=userId and Players:GetPlayerByUserId(userId) or nil
 local username,displayName,identity
 if sender then
  username,displayName,identity=sender.Name,sender.DisplayName,tostring(sender.UserId)
 elseif chatMessage.PrefixText and chatMessage.PrefixText~="" then
  -- PrefixText may contain rich-text tags or a channel prefix. Strip formatting
  -- and use the visible speaker name when TextSource is unavailable.
  username=chatMessage.PrefixText:gsub("<[^>]->",""):gsub("%b[]%s*",""):gsub("%s*[:：]$",""):gsub("^%s+",""):gsub("%s+$","")
  if username=="" then return end
  displayName,identity=username,username
 else
  -- Do not invent a speaker for system/empty-prefix messages.
  return
 end
 local fingerprint=identity.."|"..chatMessage.Text
 local now=os.clock()
 if RecentServerChatFingerprints[fingerprint] and now-RecentServerChatFingerprints[fingerprint]<2 then return end
 RecentServerChatFingerprints[fingerprint]=now
 for key,stamp in pairs(RecentServerChatFingerprints) do
