 -- Shooter item fires one or all loose blocks currently captured by the sphere or magnet.
 local function ShootOneCapturedBlock()
  -- Prefer a sphere-captured assembly when one is available.
  for part,data in pairs(TelekinesisGlassCaptured) do
   if part and part.Parent and part:IsA("BasePart") and not part.Anchored and not IsHumanoidCharacterPart(part) then
    TelekinesisGlassCaptured[part]=nil
    if data then
     RestoreAssemblyMass(part,data.physicalStates)
     if data.mover then pcall(function() data.mover:Destroy() end) end
     if data.collisionStates then for bodyPart,wasCollidable in pairs(data.collisionStates) do if bodyPart and bodyPart.Parent then pcall(function() bodyPart.CanCollide=wasCollidable end) end end end
    end
    local ok=LaunchSphereAssembly(part)
    if ok then TelekinesisNotice("SHOOT: launched one sphere-captured block toward the crosshair.") else TelekinesisNotice("Could not launch that sphere block.") end
    return
   else
    TelekinesisGlassCaptured[part]=nil
    if data and data.mover then pcall(function() data.mover:Destroy() end) end
   end
  end
  -- Also support blocks held by the halo pickup zone.
  for part,data in pairs(HaloPickupCaptured) do
   if part and part.Parent and part:IsA("BasePart") and not part.Anchored and not IsHumanoidCharacterPart(part) then
    HaloPickupCaptured[part]=nil
    if data then
     if data.mover then pcall(function() data.mover:Destroy() end) end
     if data.collisionStates then for bodyPart,wasCollidable in pairs(data.collisionStates) do if bodyPart and bodyPart.Parent then pcall(function() bodyPart.CanCollide=wasCollidable end) end end end
     RestoreAssemblyMass(part,data.physicalStates)
    end
    local launchPart=part.AssemblyRootPart or part
    pcall(function() EnableThrownAssemblyCollision(launchPart); launchPart.AssemblyAngularVelocity=Vector3.new(0,8,0); launchPart.AssemblyLinearVelocity=GetTelekinesisAimDirection(launchPart.Position)*350+Vector3.new(0,8,0) end)
