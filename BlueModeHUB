 local function MoveTarget(direction, stepAmount)
  local moveStep = stepAmount or TelekinesisStep
  if not TelekinesisCanControl() then TelekinesisNotice("Open the Telekinesis GUI or equip the Telekinesis Tool first."); return end
  if TelekinesisGlassActive and TelekinesisGlassSphere and TelekinesisGlassSphere.Parent then
   -- Move the glass zone on fixed world axes, independent of camera orientation:
   -- Left/Right = world X, Up/Down = world Z, UP/DOWN buttons = world Y.
   if direction=="Left" then TelekinesisGlassOffset=TelekinesisGlassOffset-Vector3.new(1,0,0)*moveStep
   elseif direction=="Right" then TelekinesisGlassOffset=TelekinesisGlassOffset+Vector3.new(1,0,0)*moveStep
   elseif direction=="Up" then TelekinesisGlassOffset=TelekinesisGlassOffset-Vector3.new(0,0,1)*moveStep
   elseif direction=="Down" then TelekinesisGlassOffset=TelekinesisGlassOffset+Vector3.new(0,0,1)*moveStep
   elseif direction=="Forward" then TelekinesisGlassOffset=TelekinesisGlassOffset+Vector3.new(0,1,0)*moveStep
   elseif direction=="Back" then TelekinesisGlassOffset=TelekinesisGlassOffset-Vector3.new(0,1,0)*moveStep end
   return
  end
  if not TelekinesisTarget or not TelekinesisTarget.Parent then TelekinesisNotice("Start the glass pickup zone or select a block first."); return end
  -- Arrow buttons can pick up the selected movable assembly automatically, rather than
  -- doing nothing just because PICK UP has not been pressed yet.
  if not TelekinesisMover or not TelekinesisMover.Parent then
   local target=TelekinesisTarget
   if IsHumanoidCharacterPart(target) then TelekinesisNotice("NPCs and characters are excluded. Select an unanchored block instead."); return end
   local rootPart=target.AssemblyRootPart or target
   if target.Anchored or rootPart.Anchored then TelekinesisNotice("That selected block/assembly is anchored."); return end
   TelekinesisTarget=rootPart
   local character=LocalPlayer.Character
   local root=character and character:FindFirstChild("HumanoidRootPart")
   local camera=Workspace.CurrentCamera
   local look=(camera and camera.CFrame.LookVector) or (root and root.CFrame.LookVector) or Vector3.new(0,0,-1)
   local holdPosition=root and (root.Position+look*8+Vector3.new(0,2,0)) or rootPart.Position
   local ok,mover=pcall(function()
    local bp=Instance.new("BodyPosition")
    bp.Name="BlueModeTelekinesisPosition"
    bp.MaxForce=Vector3.new(1e8,1e8,1e8); bp.P=30000; bp.D=1800
    bp.Position=holdPosition; bp.Parent=rootPart
    return bp
   end)
   if not ok or not mover then TelekinesisNotice("Could not pick up this block locally."); return end
   TelekinesisMover=mover
   MakeAssemblyLight(rootPart)
   TelekinesisTargetPosition=holdPosition
   TelekinesisFollowOffset=Vector3.new(0,0,0)
   TelekinesisPickButton.Text="BLOCK PICKED UP"
   if TelekinesisRenderConnection then TelekinesisRenderConnection:Disconnect() end
   TelekinesisRenderConnection=RunService.RenderStepped:Connect(function()
    if not TelekinesisTarget or not TelekinesisTarget.Parent or not TelekinesisMover or not TelekinesisMover.Parent then ReleaseTelekinesis(); return end
    if TelekinesisTarget.Anchored or ((TelekinesisTarget.AssemblyRootPart or TelekinesisTarget).Anchored) then ReleaseTelekinesis(); return end
    local characterNow=LocalPlayer.Character
    local rootNow=characterNow and characterNow:FindFirstChild("HumanoidRootPart")
    local cameraNow=Workspace.CurrentCamera
    if rootNow then
     local look=(cameraNow and cameraNow.CFrame.LookVector) or rootNow.CFrame.LookVector
     TelekinesisTargetPosition=rootNow.Position+look*8+Vector3.new(0,2,0)+TelekinesisFollowOffset
    end
    TelekinesisMover.Position=TelekinesisTargetPosition
   end)
  end
  local camera=Workspace.CurrentCamera
  local character=LocalPlayer.Character
  local root=character and character:FindFirstChild("HumanoidRootPart")
  if not camera and not root then return end
  local basis=camera and camera.CFrame or root.CFrame
  local right=basis.RightVector
  local forward=basis.LookVector
  local up=Vector3.new(0,1,0)
  -- Arrow up/down move the held block forward/backward relative to the camera.
  -- The separate UP/DOWN buttons move it vertically.
  if direction=="Left" then TelekinesisFollowOffset=TelekinesisFollowOffset-right*moveStep
  elseif direction=="Right" then TelekinesisFollowOffset=TelekinesisFollowOffset+right*moveStep
  elseif direction=="Up" then TelekinesisFollowOffset=TelekinesisFollowOffset+forward*moveStep
  elseif direction=="Down" then TelekinesisFollowOffset=TelekinesisFollowOffset-forward*moveStep
  elseif direction=="Forward" then TelekinesisFollowOffset=TelekinesisFollowOffset+up*moveStep
  elseif direction=="Back" then TelekinesisFollowOffset=TelekinesisFollowOffset-up*moveStep end
 end
 -- Hold-to-move controls: while the player keeps a button pressed, keep
 -- nudging the held block in that direction. Supports mouse and touch input.
 local function BindHoldMove(button, direction)
  if not button then return end
  local heldInputs = {}
  button.InputBegan:Connect(function(input)
   if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
   heldInputs[input] = true
   if CharacterFlyConnection and CharacterFlyInputs[direction]~=nil then
    CharacterFlyInputs[direction]=true
    return
   end
   task.spawn(function()
    while heldInputs[input] and button.Parent and TelekinesisCanControl() do
     if CharacterFlyConnection and CharacterFlyInputs[direction]~=nil then
      CharacterFlyInputs[direction]=true
     else
      MoveTarget(direction, 0.45)
     end
     task.wait(0.05)
    end
    heldInputs[input] = nil
    if CharacterFlyInputs[direction]~=nil then CharacterFlyInputs[direction]=false end
   end)
  end)
  button.InputEnded:Connect(function(input)
   heldInputs[input] = nil
   if CharacterFlyInputs[direction]~=nil then CharacterFlyInputs[direction]=false end
  end)
  UserInputService.InputEnded:Connect(function(input)
   if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
    heldInputs[input] = nil
   end
  end)
 end
 for direction,button in pairs(TelekinesisDirectionButtons) do
  BindHoldMove(button, direction)
 end
 BindHoldMove(TelekinesisForwardButton, "Forward")
 BindHoldMove(TelekinesisBackButton, "Back")
end

