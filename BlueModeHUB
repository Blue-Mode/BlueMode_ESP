-- Aim through the exact crosshair center. If an origin is supplied, aim from
-- the thrown block toward the point under the reticle to compensate for the
-- block starting off to the side of the camera.
local function GetTelekinesisAimDirection(originPosition)
 local camera = Workspace.CurrentCamera
 if camera then
  local tappedRay=_G.__BLUE_MODE_SHOTBLOCK_TAP_RAY
  if tappedRay and tappedRay.Direction.Magnitude>0 then
   -- Aim at a point far along the exact tap ray, not just the ray direction;
   -- this compensates for the block launching from beside/below the camera.
   local aimPoint=tappedRay.Origin+tappedRay.Direction.Unit*1000
   if originPosition then
    local toward=aimPoint-originPosition
    if toward.Magnitude>0.01 then return toward.Unit end
   else return tappedRay.Direction.Unit end
  end
  local ok, ray = pcall(function()
   local aimX,aimY
   if TelekinesisCrosshair and TelekinesisCrosshair.Parent and TelekinesisCrosshair.Visible then
    local center=TelekinesisCrosshair.AbsolutePosition+TelekinesisCrosshair.AbsoluteSize*0.5
    aimX,aimY=center.X,center.Y
   else
    local viewport=camera.ViewportSize
    aimX,aimY=viewport.X*0.5,viewport.Y*0.5
   end
   return camera:ViewportPointToRay(aimX,aimY)
  end)
  if ok and ray and ray.Direction.Magnitude > 0 then
   if originPosition then
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character, TelekinesisTool, TelekinesisControls}
    params.IgnoreWater = true
    local hit = Workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
    if hit and hit.Position then
     local towardPoint = hit.Position - originPosition
     if towardPoint.Magnitude > 0.01 then return towardPoint.Unit end
    end
   end
   return ray.Direction.Unit
  end
  return camera.CFrame.LookVector.Unit
 end
 local character = LocalPlayer.Character
 local root = character and character:FindFirstChild("HumanoidRootPart")
 local fallback = root and root.CFrame.LookVector or Vector3.new(0, 0, -1)
 if originPosition and root then
  local toward = root.Position + fallback * 100 - originPosition
  if toward.Magnitude > 0.01 then return toward.Unit end
 end
 return fallback.Unit
end

