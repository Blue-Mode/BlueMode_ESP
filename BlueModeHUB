-- Roblox assemblies cannot have literal zero mass. While a loose block is held,
-- give every part in its assembly minimum supported density and remember the
-- original custom physical properties so they can be restored when released.
local HeldPhysicalPropertyStates=setmetatable({}, {__mode="k"})
local function MakeAssemblyLight(assembly)
 if not assembly or not assembly.Parent then return nil end
 local states={}
 local parts={assembly}
 pcall(function() for _,p in ipairs(assembly:GetConnectedParts(true)) do table.insert(parts,p) end end)
 for _,part in ipairs(parts) do
  if part and part:IsA("BasePart") and states[part]==nil then
   states[part]=part.CustomPhysicalProperties
   local current=part.CurrentPhysicalProperties
   pcall(function() part.CustomPhysicalProperties=PhysicalProperties.new(0.0001,current.Friction,current.Elasticity,current.FrictionWeight,current.ElasticityWeight) end)
  end
 end
 HeldPhysicalPropertyStates[assembly]=states
 return states
end
local function RestoreAssemblyMass(assembly, states)
 states=states or (assembly and HeldPhysicalPropertyStates[assembly])
 if states then
  for part,original in pairs(states) do
   if part and part.Parent then pcall(function() part.CustomPhysicalProperties=original end) end
  end
 end
 if assembly then HeldPhysicalPropertyStates[assembly]=nil end
end

