                            if not insidePlayerCharacter and part then
                                local h = BMH_GetHighlight(obj, BMH_GUN_HIGHLIGHT, obj)
                                h.FillColor = Color3.new(1,1,1)
                                h.OutlineColor = Color3.new(1,1,1)
                                h.FillTransparency = 0.25
                                h.OutlineTransparency = 0
                            end
                        end
                    end
                end
            elseif BMH_WAS_ROUND_ACTIVE then
