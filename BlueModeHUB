local function HandleIncomingChat(username,displayName,message,userId)
 if message==nil or tostring(message)=="" then return end
 local original=tostring(message)
 -- Show the received Roblox message immediately. Translation must never block chat display.
 local entry=AddChatEntry(username,displayName,"Translating...",userId,nil,nil,original)
 if not entry then return end
 local historyRecord=nil
 for i=#SharedChatHistory,1,-1 do
  local item=SharedChatHistory[i]
  if item and tostring(item.userId or item.username)==tostring(userId or username)
    and tostring(item.originalMessage or item.message)==original then
   historyRecord=item
   break
  end
 end
