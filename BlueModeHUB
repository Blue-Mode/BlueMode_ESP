local function ApplyTypedLanguage()
 local wanted=(HeaderLanguageInput.Text or ""):match("^%s*(.-)%s*$")
 if wanted=="" then return false end
 -- Accept friendly aliases for local character-substitution languages.
 local normalized=wanted:lower():gsub("[%s_%-]","")
 if normalized=="errorlanguage" then normalized="error" end
 if normalized=="demoniclanguage" then normalized="demonic" end
 -- Common country-to-language mappings for convenient country-name search.
 local CountryLanguages={
  philippines="Filipino",philippinesenglish="English",usa="English",unitedstates="English",america="English",unitedkingdom="English",uk="English",canada="English",australia="English",newzealand="English",
  spain="Spanish",mexico="Spanish",argentina="Spanish",colombia="Spanish",chile="Spanish",peru="Spanish",venezuela="Spanish",
  france="French",belgium="French",monaco="French",germany="German",austria="German",switzerland="German",
  japan="Japanese",southkorea="Korean",korea="Korean",china="Chinese",taiwan="Chinese",singapore="English",
  brazil="Portuguese",portugal="Portuguese",saudiarabia="Arabic",egypt="Arabic",uae="Arabic",unitedarabemirates="Arabic",
  india="Hindi",pakistan="Urdu",bangladesh="Bengali",russia="Russian",italy="Italian",netherlands="Dutch",indonesia="Indonesian",vietnam="Vietnamese",thailand="Thai",turkey="Turkish",ukraine="Ukrainian",poland="Polish",greece="Greek",israel="Hebrew",malaysia="Malay",kenya="Swahili",tanzania="Swahili",iran="Persian",nepal="Nepali",romania="Romanian",czechia="Czech",sweden="Swedish",norway="Norwegian",denmark="Danish",finland="Finnish",serbia="Serbian",croatia="Croatian",slovakia="Slovak",bulgaria="Bulgarian",lithuania="Lithuanian",latvia="Latvian",estonia="Estonian"
 }
 local mapped=CountryLanguages[normalized]
 if mapped then normalized=mapped:lower() end
 for i,language in ipairs(Languages) do
  if language:lower()==normalized then
   SelectedLanguageIndex=i
   LanguageButton.Text="To: "..(language=="Error" and "Error Language" or language)
   HeaderLanguageInput.Text=(language=="Error" and "Error Language" or language)
   HeaderLanguageInput.PlaceholderText="Country or language..."
   return true
  end
 end
 local partial={}
 for i,language in ipairs(Languages) do
  if language:lower():sub(1,#wanted)==wanted:lower() then table.insert(partial,{i=i,name=language}) end
 end
 if #partial==1 then
