-- Supplemental MM2/NPC ESP updater (kept at script scope so it executes).
-- Blue Mode Hub full-update patch: MM2-only role fills + grey NPC highlights.
-- Does not add role dots or a gun tracer. All visuals obey the master ESP toggle.
getgenv().BlueMode_ESP_Enabled = false
getgenv().BlueMode_ESP_Unloading = false
local BMH_MM2_PLACE_ID = 142823291
local BMH_ROLE_HIGHLIGHT = "BMH_MM2_RoleFill"
local BMH_NPC_HIGHLIGHT = "BMH_NPC_GreyFill"
local BMH_GUN_HIGHLIGHT = "BMH_MM2_DroppedSheriffGun"
local BMH_ROLE_CACHE = {}
local BMH_WAS_ROUND_ACTIVE = false
local function BMH_IsMM2()
    return game.PlaceId == BMH_MM2_PLACE_ID
end
local function BMH_RawRole(plr)
    if not plr then return nil end
    local function roleFromText(raw)
        local value = tostring(raw or ""):lower()
        if value:find("murder") then return "murderer" end
        if value:find("sheriff") then return "sheriff" end
        return nil
    end
    -- Read common replicated role values, including nested values and attributes.
    local roots = {plr, plr.Character, plr:FindFirstChild("Data"), plr:FindFirstChild("leaderstats")}
    for _, root in ipairs(roots) do
        if root then
            for _, key in ipairs({"Role", "RoleName", "PlayerRole", "CurrentRole", "RoleValue"}) do
                local ok, attr = pcall(function() return root:GetAttribute(key) end)
                if ok then local found = roleFromText(attr); if found then BMH_ROLE_CACHE[plr.UserId] = found; return found end end
                local direct = root:FindFirstChild(key)
                if direct then
                    local okv, value = pcall(function() return direct.Value end)
                    if okv then local found = roleFromText(value); if found then BMH_ROLE_CACHE[plr.UserId] = found; return found end end
                end
            end
            for _, obj in ipairs(root:GetDescendants()) do
                local n = obj.Name:lower()
                if n == "role" or n == "rolename" or n == "playerrole" or n == "currentrole" or n == "rolevalue" then
                    local okv, value = pcall(function() return obj.Value end)
                    if okv then local found = roleFromText(value); if found then BMH_ROLE_CACHE[plr.UserId] = found; return found end end
                end
            end
        end
    end
    local teamName = plr.Team and plr.Team.Name:lower() or ""
    local teamRole = roleFromText(teamName)
    if teamRole then BMH_ROLE_CACHE[plr.UserId] = teamRole; return teamRole end
    -- Tool detection is a fallback only; cached role prevents the highlight reverting when a tool is unequipped.
    local function scanTools(where)
        if not where then return nil end
        for _, item in ipairs(where:GetChildren()) do
            if item:IsA("Tool") then
                local n = item.Name:lower()
                if n:find("knife") then return "murderer" end
                if n:find("gun") or n:find("revolver") then return "sheriff" end
            end
        end
        return nil
    end
    local toolRole = scanTools(plr.Character) or scanTools(plr:FindFirstChildOfClass("Backpack"))
    if toolRole then BMH_ROLE_CACHE[plr.UserId] = toolRole; return toolRole end
    return BMH_ROLE_CACHE[plr.UserId]
end
local function BMH_HasGun(plr)
    local function has(where)
        if not where then return false end
        for _, item in ipairs(where:GetChildren()) do
            if item:IsA("Tool") then
                local n = item.Name:lower()
                if n:find("gun") or n:find("revolver") then return true end
            end
        end
        return false
    end
    return has(plr.Character) or has(plr:FindFirstChildOfClass("Backpack"))
end
local function BMH_RoundActive()
    if not BMH_IsMM2() then return false end
    local rs = game:GetService("ReplicatedStorage")
    for _, key in ipairs({"RoundActive", "InRound", "RoundStarted", "IsRoundActive"}) do
        local v = rs:FindFirstChild(key, true)
        if v and (v:IsA("BoolValue") or v:IsA("IntValue") or v:IsA("NumberValue")) then
            -- Trust an explicit replicated round-state flag, including its false value.
            -- Do not let a cached Murderer/Sheriff role keep the round marked active.
            return v.Value == true or v.Value == 1
        end
    end
    -- If this game exposes no round-state flag, only treat the round as active
    -- while a weapon is actually present; cached role assignments are not proof
    -- that a new round is still running.
    for _, plr in ipairs(Players:GetPlayers()) do
        if BMH_HasGun(plr) then return true end
        local char = plr.Character
        if char then
            for _, item in ipairs(char:GetChildren()) do
                if item:IsA("Tool") and item.Name:lower():find("knife") then return true end
            end
        end
    end
    -- A genuine, specifically named world gun drop is also evidence that a round is active.
    for _, obj in ipairs(workspace:GetDescendants()) do
        local n = obj.Name:lower()
        if (n == "gundrop" or n == "droppedgun" or n == "dropped_gun")
            and (obj:IsA("Model") or obj:IsA("BasePart") or obj:IsA("Tool"))
            and obj:FindFirstChildWhichIsA("BasePart", true) then
            return true
        end
    end
    return false
end
local function BMH_GetHighlight(parent, name, adornee)
    local h = parent:FindFirstChild(name)
    if not h then
        h = Instance.new("Highlight")
        h.Name = name
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Parent = parent
    end
    h.Adornee = adornee
    h.Enabled = true
    return h
end
local function BMH_ClearPatchVisuals()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            for _, name in ipairs({BMH_ROLE_HIGHLIGHT, BMH_NPC_HIGHLIGHT}) do
                local h = obj:FindFirstChild(name)
                if h then h:Destroy() end
            end
        end
        local gunH = obj:FindFirstChild(BMH_GUN_HIGHLIGHT)
        if gunH then gunH:Destroy() end
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        local char = plr.Character
        local h = char and char:FindFirstChild(BMH_ROLE_HIGHLIGHT)
        if h then h:Destroy() end
    end
end
