 if hasTool(char,{gun=true, revolver=true}) or hasTool(backpack,{gun=true,revolver=true}) then return "sheriff" end
 for _,container in ipairs({plr, char}) do
  if container then
   for _,obj in ipairs(container:GetDescendants()) do
    if (obj:IsA("StringValue") or obj:IsA("IntValue")) and string.find(string.lower(obj.Name),"role",1,true) then
     local v=string.lower(tostring(obj.Value))
     if string.find(v,"murder",1,true) then return "murderer" end
     if string.find(v,"sheriff",1,true) then return "sheriff" end
    end
   end
  end
 end
 return nil
end
