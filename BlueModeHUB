local function TranslateText(text,targetLanguage)
 local req=request or http_request or (syn and syn.request)
 if type(req)~="function" then return nil,"Executor HTTP request is unavailable" end
 local response
 if TRANSLATION_ENDPOINT~="" then
  local ok,result=pcall(req,{Url=TRANSLATION_ENDPOINT,Method="POST",Headers={["Content-Type"]="application/json"},Body=HttpService:JSONEncode({text=text,targetLanguage=targetLanguage})})
  if not ok or not result then return nil,"Translation request failed" end
  response=result
  local code=tonumber(response.StatusCode or response.Status or 0)
  if code<200 or code>=300 then return nil,"Translation backend HTTP "..tostring(code) end
  local decodedOk,data=pcall(function() return HttpService:JSONDecode(response.Body or "") end)
  if not decodedOk or type(data)~="table" then return nil,"Invalid translation response" end
  local resultText=data.translatedText or data.translation or data.text
  if type(resultText)~="string" or resultText=="" then return nil,"No translated text returned" end
  return resultText,nil,(data.detectedLanguage or data.sourceLanguage or data.detected_language)
 end
 -- Fallback translation endpoint. This public endpoint is unofficial and may be rate-limited.
 local codes={English="en",Spanish="es",French="fr",German="de",Japanese="ja",Korean="ko",Chinese="zh-CN",Filipino="tl",Portuguese="pt",Arabic="ar",Hindi="hi",Russian="ru",Italian="it",Dutch="nl",Indonesian="id",Vietnamese="vi",Thai="th",Turkish="tr",Ukrainian="uk",Polish="pl",Greek="el",Hebrew="iw",Malay="ms",Swahili="sw",Bengali="bn",Urdu="ur",Tamil="ta",Telugu="te",Marathi="mr",Punjabi="pa",Romanian="ro",Czech="cs",Hungarian="hu",Swedish="sv",Norwegian="no",Danish="da",Finnish="fi",Persian="fa",Nepali="ne",Gujarati="gu",Kannada="kn",Malayalam="ml",Serbian="sr",Croatian="hr",Slovak="sk",Bulgarian="bg",Lithuanian="lt",Latvian="lv",Estonian="et"}
 local code=codes[targetLanguage] or "en"
 local url="https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl="..code.."&dt=t&q="..HttpService:UrlEncode(tostring(text))
 local ok,result=pcall(req,{Url=url,Method="GET"})
 if not ok or not result then return nil,"Translation request failed" end
 local status=tonumber(result.StatusCode or result.Status or 0)
 if status<200 or status>=300 then return nil,"Translation service HTTP "..tostring(status) end
 local decodedOk,data=pcall(function() return HttpService:JSONDecode(result.Body or "") end)
 if not decodedOk or type(data)~="table" or type(data[1])~="table" then return nil,"Invalid translation response" end
