    TelekinesisMagnetIgnoreUntil[part]=os.clock()+6
    TelekinesisMagnetIgnoreUntil[launchPart]=os.clock()+6
    if movers then
     RestoreAssemblyMass(launchPart,movers.PhysicalStates)
     for _,mover in ipairs(movers) do pcall(function() mover:Destroy() end) end
     if movers.CollisionStates then for bodyPart,wasCollidable in pairs(movers.CollisionStates) do if bodyPart and bodyPart.Parent then pcall(function() bodyPart.CanCollide=wasCollidable end) end end end
    end
    pcall(function() EnableThrownAssemblyCollision(launchPart); launchPart.AssemblyAngularVelocity=Vector3.new(0,8,0); launchPart.AssemblyLinearVelocity=GetTelekinesisAimDirection(launchPart.Position)*350+Vector3.new(0,8,0) end)
    task.spawn(function() for _=1,12 do task.wait(0.05); if launchPart and launchPart.Parent and not launchPart.Anchored then pcall(function() launchPart.AssemblyLinearVelocity=GetTelekinesisAimDirection(launchPart.Position)*350+Vector3.new(0,8,0) end) end end end)
