local CalculatorUI = nil
local CalculatorLocked = false
local CalculatorMinimized = false
local function ToggleCalculator()
    if CalculatorUI and CalculatorUI.Parent then
        CalculatorUI:Destroy()
        CalculatorUI = nil
        return
    end
    local playerGui = GuiContainer
    CalculatorUI = Instance.new("ScreenGui")
    CalculatorUI.Name = "BLUE_MODE_HUB_CALCULATOR"
    CalculatorUI.ResetOnSpawn = false
    CalculatorUI.DisplayOrder = PRIORITY.CONSOLE + 6
    CalculatorUI.Parent = playerGui

    local panel = Instance.new("Frame")
    panel.Name = "CalculatorWindow"
    panel.Size = UDim2.new(0, 300, 0, 410)
    panel.Position = UDim2.new(0.5, -150, 0.5, -205)
    panel.BackgroundColor3 = Color3.fromRGB(24, 24, 30)
    panel.BorderSizePixel = 0
    panel.Active = true
    panel.Parent = CalculatorUI
    Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 12)
    AddRainbowGlow(panel, 3)

    local title = Instance.new("TextLabel")
    title.Name = "Title"
    title.Size = UDim2.new(1, -150, 0, 38)
    title.Position = UDim2.new(0, 12, 0, 0)
    title.BackgroundTransparency = 1
    title.Text = "🧮 CALCULATOR"
    title.TextColor3 = Color3.new(1,1,1)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 15
    title.Parent = panel

    local function makeButton(name, text, size, pos, color)
        local b = Instance.new("TextButton")
        b.Name = name
        b.Text = text
        b.Size = size
        b.Position = pos
        b.BackgroundColor3 = color or Color3.fromRGB(48, 50, 60)
        b.TextColor3 = Color3.new(1,1,1)
        b.Font = Enum.Font.GothamBold
        b.TextSize = 18
        b.AutoButtonColor = true
        b.Parent = panel
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 7)
        return b
    end

    local close = makeButton("Close", "×", UDim2.new(0,30,0,28), UDim2.new(1,-35,0,5), Color3.fromRGB(160,45,45))
    local minimize = makeButton("Minimize", "−", UDim2.new(0,30,0,28), UDim2.new(1,-70,0,5))
    local lock = makeButton("Lock", "🔓", UDim2.new(0,30,0,28), UDim2.new(1,-105,0,5))
    local display = Instance.new("TextLabel")
    display.Name = "Display"
    display.Size = UDim2.new(1,-20,0,58)
    display.Position = UDim2.new(0,10,0,44)
    display.BackgroundColor3 = Color3.fromRGB(12,13,17)
    display.TextColor3 = Color3.new(1,1,1)
    display.Font = Enum.Font.GothamMedium
    display.TextSize = 25
    display.TextXAlignment = Enum.TextXAlignment.Right
    display.Text = "0"
    display.TextTruncate = Enum.TextTruncate.AtEnd
    display.Parent = panel
    Instance.new("UICorner", display).CornerRadius = UDim.new(0,7)

    local expression = ""
    local fresh = true
    local keys = {
        {"C","⌫","%","÷"},
        {"7","8","9","×"},
        {"4","5","6","−"},
        {"1","2","3","+"},
        {"±","0",".","="}
    }
    local buttons = {}
    for row, values in ipairs(keys) do
        for col, label in ipairs(values) do
            local b = makeButton("Key_"..row.."_"..col, label,
                UDim2.new(0,65,0,49), UDim2.new(0,10+(col-1)*71,0,112+(row-1)*55),
                (col==4 or label=="=") and Color3.fromRGB(25,105,175) or Color3.fromRGB(48,50,60))
            buttons[#buttons+1] = b
            b.MouseButton1Click:Connect(function()
                local current = display.Text
                if label == "C" then
                    expression = ""; display.Text = "0"; fresh = true
                elseif label == "⌫" then
                    if fresh then expression = "" else expression = expression:sub(1,-2) end
                    display.Text = expression ~= "" and expression or "0"
                elseif label == "±" then
                    local n = tonumber(current)
                    if n then expression = tostring(-n); display.Text = expression end
                elseif label == "%" then
                    local n = tonumber(current)
                    if n then expression = tostring(n/100); display.Text = expression end
                elseif label == "=" then
                    local safe = expression:gsub("×","*"):gsub("÷","/"):gsub("−","-")
                    if safe:match("^[%d%+%-%*/%.%(%)%s]+$") and not safe:match("[%+%-%*/%.]$") then
                        local fn = loadstring or load
                        local ok, result = pcall(function()
                            local f = fn("return ("..safe..")")
                            if not f then error("Invalid expression") end
                            return f()
                        end)
                        if ok and type(result)=="number" and result==result and math.abs(result)<1e100 then
                            expression = tostring(result); display.Text = expression; fresh = true
                        else display.Text = "Error"; expression = ""; fresh = true end
                    else display.Text = "Error"; expression = ""; fresh = true end
                elseif label=="+" or label=="−" or label=="×" or label=="÷" then
                    expression = (fresh and current=="0" and "" or expression)..label
                    display.Text = expression; fresh = false
                else
                    if fresh then expression = ""; fresh = false end
                    expression = expression..label
                    display.Text = expression
                end
            end)
        end
    end

    close.MouseButton1Click:Connect(function()
        if CalculatorUI then CalculatorUI:Destroy(); CalculatorUI=nil end
    end)
    local minimized = false
    minimize.MouseButton1Click:Connect(function()
        minimized = not minimized
        display.Visible = not minimized
        for _, b in ipairs(buttons) do b.Visible = not minimized end
        panel.Size = minimized and UDim2.new(0,300,0,38) or UDim2.new(0,300,0,410)
        minimize.Text = minimized and "+" or "−"
    end)
    lock.MouseButton1Click:Connect(function()
        CalculatorLocked = not CalculatorLocked
        lock.Text = CalculatorLocked and "🔒" or "🔓"
    end)
    -- Touch and mouse drag; locking disables dragging.
    local dragging, dragStart, startPos = false, nil, nil
    title.InputBegan:Connect(function(input)
        if CalculatorLocked then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = panel.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging=false end
            end)
        end
    end)
    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if dragging and not CalculatorLocked and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            panel.Position = UDim2.new(startPos.X.Scale,startPos.X.Offset+delta.X,startPos.Y.Scale,startPos.Y.Offset+delta.Y)
        end
    end)
end

