local function GetTelekinesisTargetUnderPointer()
 local camera = Workspace.CurrentCamera
 if not camera then return nil end
 local mouse = TelekinesisMouse
 if mouse then
  local ok, target = pcall(function() return mouse.Target end)
  if ok and target and target:IsA("BasePart") then return target end
 end
 local point = TelekinesisLastPointerPosition or UserInputService:GetMouseLocation()
 local ray
 local ok = pcall(function()
  -- ScreenPointToRay matches GetMouseLocation/Touch screen coordinates, including GUI inset.
  ray = camera:ScreenPointToRay(point.X, point.Y)
 end)
 if not ok or not ray then
  ray = camera:ViewportPointToRay(point.X, point.Y)
 end
 local params = RaycastParams.new()
 params.FilterType = Enum.RaycastFilterType.Exclude
 params.FilterDescendantsInstances = {LocalPlayer.Character, TelekinesisTool, TelekinesisControls}
 params.IgnoreWater = true
 local result = Workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
 if result and result.Instance and result.Instance:IsA("BasePart") then
  return result.Instance
 end
 -- Fallback to the center of the camera if the pointer position is unavailable.
 local centerRay = camera:ViewportPointToRay(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
 local centerResult = Workspace:Raycast(centerRay.Origin, centerRay.Direction * 1000, params)
 return centerResult and centerResult.Instance or nil
end

local function IsHumanoidCharacterPart(part)
 if not part then return false end
 local ancestor=part.Parent
 while ancestor and ancestor~=Workspace do
  if ancestor:IsA("Model") and ancestor:FindFirstChildOfClass("Humanoid") then
   return true
  end
  ancestor=ancestor.Parent
 end
 return false
end

local function SelectTelekinesisTarget()
 if not TelekinesisCanControl() then return end
 local target=GetTelekinesisTargetUnderPointer()
 if not target or not target:IsA("BasePart") then
  TelekinesisNotice("No block selected. Tap/click directly on an unanchored block in the world.")
  return
 end
 if IsHumanoidCharacterPart(target) then
  TelekinesisNotice("NPCs and characters are excluded. Select an unanchored block instead.")
  return
 end
 local character=LocalPlayer.Character
 if character and target:IsDescendantOf(character) then return end
 if TelekinesisMover then ReleaseTelekinesis() end
 local clickedPart=target
 local assemblyRoot=clickedPart.AssemblyRootPart or clickedPart
 if clickedPart.Anchored or assemblyRoot.Anchored then
  TelekinesisTarget=clickedPart
  TelekinesisTargetPosition=clickedPart.Position
  if TelekinesisPickButton then TelekinesisPickButton.Text="PICK UP: "..clickedPart.Name end
