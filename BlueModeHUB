local function SetShotBlockAimRay(screenPos)
 local camera=Workspace.CurrentCamera
 if not camera then return false end
 local pos=screenPos
 if not pos then pos=UserInputService:GetMouseLocation() end
 if not pos then return false end
 local guiService=game:GetService("GuiService")
 local inset=guiService:GetGuiInset()
 local ray=nil
 -- MouseLocation and Input.Position are screen-space coordinates. Prefer
 -- ScreenPointToRay so the tap/click lands at the same screen pixel; fall back
 -- to viewport coordinates if the runtime does not support it.
 local ok=pcall(function() ray=camera:ScreenPointToRay(pos.X,pos.Y) end)
 if not ok or not ray then
  ok=pcall(function() ray=camera:ViewportPointToRay(pos.X-inset.X,pos.Y-inset.Y) end)
 end
 if ok and ray then _G.__BLUE_MODE_SHOTBLOCK_TAP_RAY=ray; return true end
 return false
end
