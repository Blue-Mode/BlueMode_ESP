local function TranslateText(text,targetLanguage)
 local req=request or http_request or (syn and syn.request)
 if type(req)~="function" then return nil,"Executor HTTP request is unavailable" end
 text=tostring(text or "")
 targetLanguage=tostring(targetLanguage or "English")
 if text=="" then return "",nil end
 local backendError="Translation backend unavailable"
 local endpoint=TRANSLATION_ENDPOINT
 if type(endpoint)=="string" and endpoint~="" then
  -- Try the common API field names separately. Some small APIs reject unknown JSON fields.
  local payloads={
   {text=text,targetLanguage=targetLanguage},
   {text=text,target_language=targetLanguage},
   {text=text,target=targetLanguage},
   {text=text,target_lang=targetLanguage},
   {message=text,targetLanguage=targetLanguage},
   {q=text,target=targetLanguage}
  }
  local function getTranslation(data)
   if type(data)~="table" then return nil end
   local value=data.translatedText or data.translated_text or data.translation or data.translated or data.result or data.output or data.text
   if type(value)=="table" then
    value=value.translatedText or value.translated_text or value.translation or value.translated or value.text or value.output
   end
   if type(value)=="string" and value~="" and value~=text then return value end
   if type(data.data)=="table" then return getTranslation(data.data) end
   if type(data.result)=="table" then return getTranslation(data.result) end
   return nil
  end
  for _,payload in ipairs(payloads) do
   local requestOk,response=pcall(req,{Url=endpoint,Method="POST",Headers={ ["Content-Type"]="application/json", ["Accept"]="application/json" },Body=HttpService:JSONEncode(payload)})
   if requestOk and type(response)=="table" then
    local status=tonumber(response.StatusCode or response.Status or 0)
    local body=tostring(response.Body or "")
    local decodedOk,data=pcall(function() return HttpService:JSONDecode(body) end)
    if decodedOk and type(data)=="table" then
     local resultText=getTranslation(data)
     if (status==0 or (status>=200 and status<300)) and data.ok~=false and resultText then
      return resultText,nil,(data.detectedLanguage or data.sourceLanguage or data.detected_language or data.source_language or data.source)
     end
     if data.ok==false then
      backendError=tostring(data.error or data.message or "Backend returned ok=false")
     elseif status~=0 and (status<200 or status>=300) then
      backendError="Translation backend HTTP "..tostring(status)..(data.error and (": "..tostring(data.error)) or "")
     elseif not resultText then
      backendError=tostring(data.error or data.message or "Backend response did not contain translated text")
     end
    elseif status~=0 and (status<200 or status>=300) then
     backendError="Translation backend HTTP "..tostring(status)
    elseif body~="" then
     backendError="Invalid translation response: "..string.sub(body,1,120)
    else
     backendError="Translation backend returned an empty response"
    end
   elseif not requestOk then
    backendError="Translation POST request error: "..tostring(response)
   else
    backendError="Translation POST returned no response"
   end
  end
 end
 -- Public Google endpoint fallback. This is attempted only if the configured API fails.
 local codes={English="en",Spanish="es",French="fr",German="de",Japanese="ja",Korean="ko",Chinese="zh-CN",Filipino="tl",Portuguese="pt",Arabic="ar",Hindi="hi",Russian="ru",Italian="it",Dutch="nl",Indonesian="id",Vietnamese="vi",Thai="th",Turkish="tr",Ukrainian="uk",Polish="pl",Greek="el",Hebrew="iw",Malay="ms",Swahili="sw",Bengali="bn",Urdu="ur",Tamil="ta",Telugu="te",Marathi="mr",Punjabi="pa",Romanian="ro",Czech="cs",Hungarian="hu",Swedish="sv",Norwegian="no",Danish="da",Finnish="fi",Persian="fa",Nepali="ne",Gujarati="gu",Kannada="kn",Malayalam="ml",Serbian="sr",Croatian="hr",Slovak="sk",Bulgarian="bg",Lithuanian="lt",Latvian="lv",Estonian="et"}
 local code=codes[targetLanguage] or "en"
 local url="https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl="..code.."&dt=t&q="..HttpService:UrlEncode(text)
 local fallbackOk,fallbackResponse=pcall(req,{Url=url,Method="GET",Headers={ ["Accept"]="application/json" }})
 if not fallbackOk or type(fallbackResponse)~="table" then return nil,backendError.."; fallback request failed" end
 local fallbackStatus=tonumber(fallbackResponse.StatusCode or fallbackResponse.Status or 0)
 if fallbackStatus~=0 and (fallbackStatus<200 or fallbackStatus>=300) then return nil,backendError.."; fallback HTTP "..tostring(fallbackStatus) end
 local decodedOk,data=pcall(function() return HttpService:JSONDecode(fallbackResponse.Body or "") end)
 if not decodedOk or type(data)~="table" or type(data[1])~="table" then return nil,backendError.."; fallback response invalid" end
 local parts={}
 for _,segment in ipairs(data[1]) do if type(segment)=="table" and type(segment[1])=="string" then table.insert(parts,segment[1]) end end
 local translated=table.concat(parts)
 if translated=="" then return nil,backendError.."; fallback returned no text" end
 return translated,nil,data[3]
end
