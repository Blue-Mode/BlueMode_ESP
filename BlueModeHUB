local function GetMM2Role(plr)
 local function hasTool(container, names)
  if not container then return false end
  for _,obj in ipairs(container:GetChildren()) do
   if obj:IsA("Tool") and names[string.lower(obj.Name)] then return true end
  end
  return false
 end
 local char=plr.Character
 local backpack=plr:FindFirstChildOfClass("Backpack")
 if hasTool(char,{knife=true}) or hasTool(backpack,{knife=true}) then return "murderer" end
 if hasTool(char,{gun=true, revolver=true}) or hasTool(backpack,{gun=true,revolver=true}) then return "sheriff" end
 for _,container in ipairs({plr, char}) do
  if container then
   for _,obj in ipairs(container:GetDescendants()) do
    if (obj:IsA("StringValue") or obj:IsA("IntValue")) and string.find(string.lower(obj.Name),"role",1,true) then
     local v=string.lower(tostring(obj.Value))
     if string.find(v,"murder",1,true) then return "murderer" end
     if string.find(v,"sheriff",1,true) then return "sheriff" end
    end
   end
  end
 end
 return nil
end
local function ConnectMM2RoleTP(button,role,defaultText)
 local busy=false
 button.MouseButton1Click:Connect(function()
  if busy then return end
  if game.PlaceId~=142823291 then
   button.Text="❌ MM2 ONLY"
   task.delay(1.5,function() if button.Parent then button.Text=defaultText end end)
   return
  end
  local myChar=LocalPlayer.Character
  local myRoot=myChar and myChar:FindFirstChild("HumanoidRootPart")
  if not myRoot then return end
  local target=nil
  for _,plr in ipairs(Players:GetPlayers()) do
   if plr~=LocalPlayer and GetMM2Role(plr)==role then
    local ch=plr.Character local root=ch and ch:FindFirstChild("HumanoidRootPart")
    if root then target=root break end
   end
  end
  if not target then
   button.Text=role=="murderer" and "❌ MURD NOT FOUND" or "❌ SHERIFF NOT FOUND"
   task.delay(1.5,function() if button.Parent then button.Text=defaultText end end)
   return
  end
  busy=true button.Text="⏳ TELEPORTING..."
  local angle=math.random()*math.pi*2
  local radius=math.random(1,1000)/100 -- 0.01 to 10 studs
  local offset=Vector3.new(math.cos(angle)*radius,2,math.sin(angle)*radius)
  local ok=pcall(function() myRoot.CFrame=CFrame.new(target.Position+offset,target.Position) end)
  button.Text=ok and "✅ TELEPORTED" or "❌ FAILED"
  task.delay(1.2,function() if button.Parent then button.Text=defaultText end busy=false end)
 end)
end
