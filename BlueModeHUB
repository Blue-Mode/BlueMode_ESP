  local ok,translated,err,detectedCode=pcall(function()
   local value,why,code=TranslateText(original,"English")
   return value,why,code
  end)
  if not ok then err=translated; translated=nil; detectedCode=nil end
  local detectedLanguage=nil
  if type(detectedCode)=="string" then
   local codeNames={en="English",es="Spanish",fr="French",de="German",ja="Japanese",ko="Korean",zh="Chinese",tl="Filipino",fil="Filipino",pt="Portuguese",ar="Arabic",hi="Hindi",ru="Russian",it="Italian",nl="Dutch",id="Indonesian",vi="Vietnamese",th="Thai",tr="Turkish",uk="Ukrainian",pl="Polish",el="Greek",iw="Hebrew",he="Hebrew",ms="Malay",sw="Swahili",bn="Bengali",ur="Urdu",ta="Tamil",te="Telugu",mr="Marathi",pa="Punjabi",ro="Romanian",cs="Czech",hu="Hungarian",sv="Swedish",no="Norwegian",da="Danish",fi="Finnish",fa="Persian",ne="Nepali",gu="Gujarati",kn="Kannada",ml="Malayalam",sr="Serbian",hr="Croatian",sk="Slovak",bg="Bulgarian",lt="Lithuanian",lv="Latvian",et="Estonian"}
   -- Accept language tags such as en-US, pt_BR, and zh-CN.
   local normalized=string.lower(detectedCode):gsub("_","-")
   detectedLanguage=codeNames[normalized] or codeNames[normalized:match("^([a-z]+)")]
  end
  local displayText
  if translated and tostring(translated)~="" then
   displayText=tostring(translated)
  else
   displayText="[English translation unavailable] "..original
   warn("[BLUE MODE CHAT] Incoming translation failed: "..tostring(err))
