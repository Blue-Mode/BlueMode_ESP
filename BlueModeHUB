local function EncodeErrorLanguage(text)
 -- Error is a local letter-substitution style, not a machine-translation language.
 local replacements={a="4",i="1",e="3",t="†",s="$",n="Ñ",x="×",g="@",o="0",l="|",["?"]="¿"}
 return (tostring(text):gsub("[%a?]",function(char)
  return replacements[char:lower()] or char
 end))
end
local function EncodeDemonicLanguage(text)
 -- Fictional Demonic substitution alphabet with separate uppercase/lowercase letters
 -- and digit glyphs. This is a visual encoding, not a real-world language or encryption.
 local lower={
  a="ɑ",b="ь",c="ϲ",d="đ",e="ɛ",f="ғ",g="ɡ",h="ҥ",i="ɪ",j="ʝ",
  k="ҡ",l="ł",m="м",n="и",o="ø",p="р",q="զ",r="я",s="ѕ",t="т",
  u="υ",v="ν",w="ш",x="х",y="у",z="ᴢ"
 }
 local upper={
  A="Λ",B="Ɓ",C="Ͼ",D="Ð",E="Ξ",F="Ғ",G="Ǥ",H="Ң",I="Ɨ",J="Ɉ",
  K="Ҡ",L="Ł",M="Ϻ",N="И",O="Ø",P="Ҏ",Q="Ҩ",R="Я",S="Ϟ",T="Ŧ",
  U="Ц",V="Ѵ",W="Ш",X="Ж",Y="Ұ",Z="Ƶ"
 }
 local digits={ ["0"]="⓿",["1"]="➊",["2"]="➋",["3"]="➌",["4"]="➍",
  ["5"]="➎",["6"]="➏",["7"]="➐",["8"]="➑",["9"]="➒" }
 return (tostring(text):gsub("[A-Za-z0-9]",function(char)
  if char:match("%d") then return digits[char] or char end
  if char:match("%u") then return upper[char] or char end
  return lower[char] or char
 end))
end
local function SendChatMessage()
 ApplyTypedLanguage()
 local raw=ChatInput.Text
 if raw=="" or raw:match("^%s*$") then return end
 ChatInput.Text=""
 task.spawn(function()
  local outgoing=raw
  local targetLanguage=Languages[SelectedLanguageIndex]
  if targetLanguage=="Error" then
   outgoing=EncodeErrorLanguage(raw)
  elseif targetLanguage=="Demonic" then
   outgoing=EncodeDemonicLanguage(raw)
  elseif targetLanguage~="English" then
   local translated,err=TranslateText(raw,targetLanguage)
   if translated and translated~="" then
    outgoing=translated
   else
    warn("[BLUE MODE CHAT] Translation failed: "..tostring(err).."; sending the original message.")
   end
  end

  local sent=false
  local sendError="No usable TextChatService channel was found."
  -- Try the default public channel first, then other non-system TextChannels that belong to this experience.
  -- Send only once: looping every channel can duplicate a public message or send into team/whisper channels.
  local channels=TextChatService:FindFirstChild("TextChannels")
  local candidates={}
  if channels then
   local general=channels:FindFirstChild("RBXGeneral")
   if general and general:IsA("TextChannel") then table.insert(candidates,general) end
   for _,candidate in ipairs(channels:GetChildren()) do
    if candidate:IsA("TextChannel") and candidate.Name~="RBXSystem" and candidate~=general then
     -- Prefer public/general-looking channels before team or whisper channels.
     if candidate.Name:lower():find("general") or candidate.Name:lower():find("public") or candidate.Name:lower():find("global") then
      table.insert(candidates,1,candidate)
     else
      table.insert(candidates,candidate)
     end
    end
   end
  end
  local errors={}
  for _,channel in ipairs(candidates) do
   local ok,err=pcall(function() channel:SendAsync(outgoing) end)
   if ok then
    sent=true
    break
   else
    table.insert(errors,channel.Name..": "..tostring(err))
   end
  end
  if not sent and #errors>0 then sendError=table.concat(errors," | ") end

  -- Compatibility fallback for experiences still using Roblox's legacy chat.
  if not sent then
   local ok,err=pcall(function()
    local replicated=game:GetService("ReplicatedStorage")
    local legacy=replicated:FindFirstChild("DefaultChatSystemChatEvents")
    local say=legacy and legacy:FindFirstChild("SayMessageRequest")
    if not say then error("Legacy chat remote is unavailable.") end
    say:FireServer(outgoing,"All")
   end)
   if ok then
    sent=true
   else
    sendError=sendError.." | Legacy chat: "..tostring(err)
   end
  end

  if not sent then
   warn("[BLUE MODE CHAT] Message was not sent: "..sendError)
   if AddChatEntry then
    AddChatEntry(LocalPlayer.Name,LocalPlayer.DisplayName,"⚠ NOT SENT — "..sendError,LocalPlayer.UserId)
   end
  end
 end)
end
