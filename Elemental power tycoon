	stroke.Thickness = 2
	stroke.Transparency = 0.3
	stroke.Parent = floatingBtn

	local dragging = false
	local dragStart = nil
	local startPos = nil

	floatingBtn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = floatingBtn.Position
		end
	end)

	floatingBtn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if dragging then
				dragging = false
			else
				config.guiOpen = not config.guiOpen

				local existing = playerGui:FindFirstChild("FuturisticExecutorMenu")
				if existing then
					existing:Destroy()
				end

				if config.guiOpen then
					createMainGui()
				end
			end
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and dragging then
			local delta = input.Position - dragStart
			floatingBtn.Position = startPos + UDim2.new(0, delta.X, 0, delta.Y)
		end
	end)
end

-- PC toggle
if not config.isMobile then
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.KeyCode == config.hotkey then
			config.guiOpen = not config.guiOpen

			local existing = playerGui:FindFirstChild("FuturisticExecutorMenu")
			if existing then
				existing:Destroy()
			end

			if config.guiOpen then
				createMainGui()
			end
		end
	end)
end

-- Initialize
if config.isMobile then
	createMobileButton()
	notify("📱 Mobile Executor loaded. Tap ⚡ to open.", Color3.fromRGB(95, 220, 255))
else
	notify("✨ Executor loaded. Press Q to open.", Color3.fromRGB(95, 220, 255))
end
