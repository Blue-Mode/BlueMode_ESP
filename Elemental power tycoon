local function getAllPlayerWeapons(target)
	local tools = {}
	for _, child in ipairs(target.Character and target.Character:GetDescendants() or {}) do
		if child:IsA("Tool") then
			table.insert(tools, child)
		end
	end

	if target.Backpack then
		for _, obj in ipairs(target.Backpack:GetChildren()) do
			if obj:IsA("Tool") then
				table.insert(tools, obj)
			end
		end
	end

	return tools
end

local function equipWeapon(tool)
	if not tool or not player.Character then return end

	local clone = tool:Clone()
	clone.Parent = player.Character

	local hum = player.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		hum:EquipTool(clone)
	end
end

local function executePower(power)
	local now = tick()
	if cooldowns[power.Name] and (now - cooldowns[power.Name]) < power.Cooldown then
		notify("⏱️ " .. power.Name .. " is cooling down!", Color3.fromRGB(255, 120, 120))
		return
	end

	cooldowns[power.Name] = now

	if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
		local hrp = player.Character.HumanoidRootPart
		local effect = Instance.new("Part")
		effect.Shape = Enum.PartType.Ball
		effect.Material = Enum.Material.Neon
		effect.Color = power.Color
		effect.Size = Vector3.new(2.5, 2.5, 2.5)
		effect.CanCollide = false
		effect.Position = hrp.Position + hrp.CFrame.LookVector * 10
		effect.Parent = workspace
		Debris:AddItem(effect, 1.5)
	end

	notify(power.Icon .. " " .. power.Name .. " used! Damage: " .. power.Power, power.Color)
end

local function teleportToPlayer(targetName)
	for _, target in ipairs(Players:GetPlayers()) do
		if target.Name:lower():find(targetName:lower()) then
			if target.Character and target.Character:FindFirstChild("HumanoidRootPart") and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
				player.Character.HumanoidRootPart.CFrame = target.Character.HumanoidRootPart.CFrame + Vector3.new(0, 4, 0)
				notify("✅ Teleported to " .. target.Name, Color3.fromRGB(90, 255, 180))
				return true
			end
		end
	end

	notify("❌ Player not found!", Color3.fromRGB(255, 120, 120))
	return false
end

local function killAllPlayers()
	local targets = {}
	for _, target in ipairs(Players:GetPlayers()) do
		if target ~= player then
			table.insert(targets, target)
		end
	end

	if #targets == 0 then
		notify("❌ No players to kill!", Color3.fromRGB(255, 120, 120))
		return
	end

	local weapons = {}
	for _, target in ipairs(targets) do
		for _, weapon in ipairs(getAllPlayerWeapons(target)) do
			table.insert(weapons, weapon)
		end
	end

	if #weapons > 0 then
		equipWeapon(weapons[1])
	end

	for _, target in ipairs(targets) do
		if target.Character then
			local hum = target.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.Health = 0
				killStats[player.Name] = (killStats[player.Name] or 0) + 1
			end
		end
	end

	notify("💀 Kill All executed! " .. #targets .. " players eliminated.", Color3.fromRGB(255, 80, 80))
end

local function createRoundedButton(parent, text, bg, textColor, size, pos)
	local btn = Instance.new("TextButton")
	btn.Size = size
	btn.Position = pos
	btn.BackgroundColor3 = bg
	btn.BorderSizePixel = 0
	btn.Text = text
	btn.TextColor3 = textColor
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 12
	btn.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = btn

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(135, 200, 255)
	stroke.Transparency = 0.35
	stroke.Thickness = 1.2
	stroke.Parent = btn

	return btn
end

