-- ═══════════════════════════════════════════
-- ANIMATION — CYBER RAINBOW PULSE
-- ═══════════════════════════════════════════
local hue = 0
local pulse = 0
RunService.Heartbeat:Connect(function()
    hue = (hue + 0.0025) % 1
    pulse = (math.sin(os.clock() * 3) + 1) / 2
    
    local neon = Color3.fromHSV(hue * 0.6 + 0.55, 1, 1)
    local glowAlpha = 0.5 + pulse * 0.3
    
    -- Outer glow pulsing
    OuterGlow.BackgroundColor3 = neon
    OuterGlow.BackgroundTransparency = 1 - glowAlpha
    
    -- Border colors
    MainFrame.BorderColor3 = neon
    TopBar.BackgroundColor3 = neon
    PuzzleFrame.BorderColor3 = Color3.fromHSV((hue + 0.15) % 1, 0.9, 1)
    InputFrame.BorderColor3 = neon
    SubmitFrame.BorderColor3 = Color3.fromHSV((hue + 0.3) % 1, 1, 1)
    
    -- Text glow
    TitleLabel.TextColor3 = neon
    SubmitBtn.TextColor3 = Color3.fromHSV((hue + 0.3) % 1, 1, 0.95)
end)

