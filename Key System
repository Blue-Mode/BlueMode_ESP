-- ══════════════════════════════════════════════
-- COLOR ANIMATION — PURPLE → BLUE → GREEN → RED
-- ══════════════════════════════════════════════
local hue = 0
RunService.Heartbeat:Connect(function()
    hue = (hue + 0.002) % 1
    
    -- Full cycle: Purple → Blue → Green → Red
    local accentColor = Color3.fromHSV(hue, 1, 1)
    
    -- Outer glow
    OuterGlow.BackgroundColor3 = accentColor
    OuterGlow.BackgroundTransparency = 0.6 + math.sin(hue * math.pi * 2) * 0.15
    
    -- Borders & Bars
    MainFrame.BorderColor3 = accentColor
    TopGlowBar.BackgroundColor3 = accentColor
    PuzzlePanel.BorderColor3 = accentColor
    InputPanel.BorderColor3 = accentColor
    ButtonPanel.BorderColor3 = accentColor
    
    -- Corner bars
    for _, bar in ipairs(CornerBars) do
        bar.BackgroundColor3 = accentColor
    end
    
    -- Text accents
    MainTitle.TextColor3 = accentColor
    UnlockBtn.TextColor3 = accentColor
    PuzzleText.TextColor3 = Color3.fromHSV((hue + 0.05) % 1, 0.9, 1)
end)

